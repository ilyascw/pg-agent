# OpenAI-compatible Chat Completions endpoint, as seen from the database container.
LLM_BASE_URL=http://host.docker.internal:8090/v1
LLM_API_KEY=0
LLM_MODEL=
# Function field for tool example calls, for endpoints that accept them. Empty: do not send.
LLM_TOOL_EXAMPLES_FIELD=

# Connectors
PG_AGENT_DSN=postgresql://agent:agent@localhost:5433/agent
PG_AGENT_NAME=personal

# Telegram connector: token from @BotFather, user ids allowed to talk to the bot (comma-separated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
